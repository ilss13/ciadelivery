# Ambiente da aplicação: local, development, staging ou production.
NODE_ENV=local

# Porta HTTP da API.
API_PORT=3000

# Porta HTTP do health interno do worker.
WORKER_PORT=3001

# MySQL. No Compose o host é o serviço `mysql`. Na máquina, use localhost.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=ciadelivery
# Senha só de desenvolvimento. Staging e production não têm este valor como padrão.
DATABASE_PASSWORD=ciadelivery
DATABASE_NAME=ciadelivery

# Redis. No Compose o host é o serviço `redis`. Na máquina, use localhost.
REDIS_HOST=localhost
REDIS_PORT=6379

# Domínio usado para resolver a loja pelo host.
PLATFORM_DOMAIN=localhost

# Segredo HMAC do access token. Mínimo de 32 caracteres. A API não sobe sem ele.
# Valor só de desenvolvimento. Staging e production não usam este padrão.
JWT_ACCESS_SECRET=local-development-jwt-access-secret

# Seed do SUPER_ADMIN. Recusado em production. Não deixe senha vazia quando for true.
SEED_PLATFORM_ADMIN=false
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Em local e development, inclui o token de redefinição de senha no log somente se true.
LOG_PASSWORD_RESET=false

# Fuso gravado na loja ao criá-la. Se a variável faltar, o padrão é America/Sao_Paulo.
STORE_TIMEZONE=America/Sao_Paulo

# Seed de duas lojas de demonstração. Recusado em production. A senha não tem valor padrão.
SEED_DEMO=false
DEMO_OWNER_PASSWORD=

# Tamanho do pool MySQL. Se a variável faltar, o padrão é 10.
DATABASE_POOL_SIZE=10

# Origens CORS separadas por vírgula. Uma origem fora da lista é recusada.
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202,http://localhost:4203,http://pizzariadoze.localhost:4201,http://burgercentral.localhost:4201

# Senha de root do MySQL exigida pelo Compose de staging. Sem valor padrão lá.
MYSQL_ROOT_PASSWORD=

# Arquivos de produto, logo, favicon e banner. local grava em disco. s3 usa endpoint compatível.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3000
# Obrigatórias só quando STORAGE_DRIVER=s3.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
