{
  "name": "ciadelivery",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start:api": "nx serve api",
    "start:worker": "nx serve worker",
    "start:landing": "nx serve landing",
    "start:storefront": "nx serve storefront",
    "start:admin": "nx serve admin",
    "start:courier": "nx serve courier",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "openapi:generate": "TS_NODE_PROJECT=tsconfig.cli.json node -r ts-node/register -r tsconfig-paths/register apps/api/src/generate-openapi.ts",
    "migration:generate": "TS_NODE_PROJECT=tsconfig.cli.json typeorm-ts-node-commonjs migration:generate -d apps/api/src/database/data-source.ts",
    "migration:run": "TS_NODE_PROJECT=tsconfig.cli.json typeorm-ts-node-commonjs migration:run -d apps/api/src/database/data-source.ts",
    "migration:revert": "TS_NODE_PROJECT=tsconfig.cli.json typeorm-ts-node-commonjs migration:revert -d apps/api/src/database/data-source.ts"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.1.0",
