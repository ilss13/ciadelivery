  "info": {
    "title": "ciadelivery",
    "description": "ciadelivery HTTP API",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthStatusResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "AddressDto": {
        "type": "object",
        "properties": {
          "line": {
            "type": "string",
            "example": "Rua das Flores"
          },
          "number": {
            "type": "string",
            "example": "100"
          },
          "district": {
            "type": "string",
            "example": "Centro"
          },
          "city": {
            "type": "string",
            "example": "Sao Paulo"
          },
          "state": {
            "type": "string",
            "example": "SP"
          },
          "postalCode": {
            "type": "string",
            "example": "01000-000"
          }
        },
        "required": [
          "line",
          "number",
          "district",
          "city",
          "state",
          "postalCode"
        ]
      },
      "CreateTenantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Padaria Central"
          },
          "slug": {
            "type": "string",
            "example": "padaria-central"
          },
          "phone": {
            "type": "string",
            "example": "11999999999"
          },
          "address": {
            "$ref": "#/components/schemas/AddressDto"
          }
        },
        "required": [
          "name",
          "slug",
          "phone",
          "address"
        ]
      },
      "StoreAddressResponse": {
        "type": "object",
        "properties": {
          "line": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "district": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          }
        },
        "required": [
          "line",
          "number",
          "district",
          "city",
          "state",
          "postalCode"
        ]
      },
      "StoreResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "$ref": "#/components/schemas/StoreAddressResponse"
          },
          "latitude": {
            "type": "number",
            "nullable": true
          },
          "longitude": {
            "type": "number",
            "nullable": true
          },
          "minimumOrderCents": {
            "type": "number"
          },
          "isManuallyClosed": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "phone",
          "address",
          "latitude",
          "longitude",
          "minimumOrderCents",
          "isManuallyClosed",
          "createdAt",
          "updatedAt"
        ]
      },
      "TenantResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED",
              "TRIAL"
            ]
          },
          "planCode": {
            "type": "string"
          },
          "customDomain": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "store": {
            "$ref": "#/components/schemas/StoreResponse"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "status",
          "planCode",
          "customDomain",
          "createdAt",
          "updatedAt",
          "store"
        ]
      },
      "PageMetaResponse": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          }
        },
        "required": [
          "page",
          "pageSize",
          "total",
          "totalPages"
        ]
      },
      "TenantListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TenantResponse"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PageMetaResponse"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "UpdateTenantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Padaria Central"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED",
              "TRIAL"
            ]
          },
          "planCode": {
            "type": "string",
            "example": "STANDARD"
          },
          "customDomain": {
            "type": "object",
            "nullable": true,
            "example": "pedidos.padaria.com"
          }
        }
      },
      "StoreAddressDto": {
        "type": "object",
        "properties": {
          "line": {
            "type": "string",
            "example": "Rua das Flores"
          },
          "number": {
            "type": "string",
            "example": "100"
          },
          "district": {
            "type": "string",
            "example": "Centro"
          },
          "city": {
            "type": "string",
            "example": "Sao Paulo"
          },
          "state": {
            "type": "string",
            "example": "SP"
          },
